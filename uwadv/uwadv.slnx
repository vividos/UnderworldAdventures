    <Project Path="source/tools/convdec/convdec.vcxproj" />
    <Project Path="source/tools/mapdisp/mapdisp.vcxproj" />
    <Project Path="source/tools/strpak/strpak.vcxproj" />
    <Project Path="source/tools/uwdump/uwdump.vcxproj" />
    <Project Path="source/tools/xmi2mid/xmi2mid.vcxproj" />
    <Project Path="source/win32/uaconfig/uaconfig.vcxproj" />
  </Folder>
  <Folder Name="/uadata/">

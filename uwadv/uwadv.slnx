<Solution>
  <Configurations>
    <Platform Name="Win32" />
  </Configurations>
  <Folder Name="/docs/">
    <File Path="docs/Features.md" />
    <File Path="docs/README.Developer.md" />
    <File Path="docs/README.Manual.md" />
    <File Path="docs/README.Tools.md" />
    <File Path="docs/uw-formats.txt" />
  </Folder>
  <Folder Name="/hacking/">
    <Project Path="hacking/hacking.vcxproj" />
  </Folder>
  <Folder Name="/helper/">
    <Project Path="cppcheck/cppcheck.vcxproj">
      <Build Solution="Release|*" Project="false" />
    </Project>
    <Project Path="doxygen/doxygen.vcxproj">
      <Build Solution="Release|*" Project="false" />
    </Project>
    <Project Path="win32/setup/setup.wixproj">
      <BuildDependency Project="source/thirdparty/thirdparty.vcxproj" />
      <BuildDependency Project="source/tools/convdec/convdec.vcxproj" />
      <BuildDependency Project="source/tools/mapdisp/mapdisp.vcxproj" />
      <BuildDependency Project="source/tools/strpak/strpak.vcxproj" />
      <BuildDependency Project="source/tools/uwdump/uwdump.vcxproj" />
      <BuildDependency Project="source/tools/xmi2mid/xmi2mid.vcxproj" />
      <BuildDependency Project="source/uwadv/uwadv.vcxproj" />
      <BuildDependency Project="source/win32/uaconfig/uaconfig.vcxproj" />
      <BuildDependency Project="source/win32/uadebug/uadebug.vcxproj" />
      <BuildDependency Project="source/win32/uastudio/uastudio.vcxproj" />
      <BuildDependency Project="uadata/uadata.vcxproj" />
      <Platform Project="x86" />
      <Build />
    </Project>
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path="vcpkg.json" />
  </Folder>
  <Folder Name="/source/">
    <Project Path="source/audio/audio.vcxproj" />
    <Project Path="source/base/base.vcxproj" />
    <Project Path="source/conv/conv.vcxproj" />
    <Project Path="source/game/game.vcxproj" />
    <Project Path="source/import/import.vcxproj" />
    <Project Path="source/physics/physics.vcxproj" />
    <Project Path="source/renderer/renderer.vcxproj" />
    <Project Path="source/screens/screens.vcxproj" />
    <Project Path="source/script/script.vcxproj" />
    <Project Path="source/ui/ui.vcxproj" />
    <Project Path="source/underworld/underworld.vcxproj" />
    <Project Path="source/unittest/unittest.vcxproj" />
    <Project Path="source/uwadv/uwadv.vcxproj">
      <BuildDependency Project="source/thirdparty/thirdparty.vcxproj" />
      <BuildDependency Project="source/win32/uadebug/uadebug.vcxproj" />
      <BuildDependency Project="uadata/uadata.vcxproj" />
    </Project>
    <Project Path="source/win32/uadebug/uadebug.vcxproj" />
    <Project Path="source/win32/uastudio/uastudio.vcxproj" />
  </Folder>
  <Folder Name="/source/thirdparty/">
    <Project Path="source/thirdparty/hqx/hqx.vcxproj" />
    <Project Path="source/thirdparty/SDL_pnglite/SDL_pnglite.vcxproj" />
